# KiBot CI output
outputs/

# KiBot generated outputs
**/Schematic/
**/JLCPCB/
**/Bom/
**/Boardview/
**/3D/
**/index.html
**/_navigate_results*/

# KiCad backups, autosaves, locks, caches and per-user view state
*-backups/
_restore_*/
_autosave-*
\#auto_saved_files\#
*.lck
*.kicad_prl
fp-info-cache
*.bak
*-bak
*.orig
.history/

# ERC/DRC reports and logs
*-erc.txt
*-drc.txt
*-erc.rpt
*-drc.rpt
*.log
production/

# Editor / OS junk
*.swp
*~
.DS_Store
Thumbs.db

# KiBot temporary files
**/.kibot/

# VSCode user-specific stuff
.vscode/*.code-workspace

# Misc
*.xlsx
*.csv
*.~lock.*
__pycache__/
*.pyc
.python-version
**/*.venv

# KiCad creates a "default" template wherever KICAD_USER_TEMPLATE_DIR points
ali/v2/default/

# Secret Nolan stuff
do-not-include/
math

# LTspice sim outputs
math/sim/**/*.raw
math/sim/**/*.net
math/sim/**/*.db
math/sim/**/*.plt
